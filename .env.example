# ---------------------------------------------------------------------------
# Template for every environment file. COMMIT THIS FILE ONLY.
# Copy it to config/<env>.env (non-secret defaults) and
# config/<env>.local.env (secrets) — both are gitignored.
#
#   cp .env.example config/development.local.env
#
# In CI these values come from repository secrets, never from a file.
# ---------------------------------------------------------------------------

# development | staging | production
TEST_ENV=development

# Store demo front-end used by the wishlist/cart suite (tests/wishlist/**)
# — a public, credential-free application.
STORE_BASE_URL=
